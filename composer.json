{
    "name": "crudadmin/gutenberg",
    "description": "This package is fork from laraberg package. To supports field in crudadmin framework.",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "GogolDev.com",
            "email": "info@marekgogol.sk",
            "homepage": "https://gogoldev.com"
        },
        {
            "name": "Maurice Wijnia",
            "email": "maurice@van-ons.nl"
        }
    ],
    "require": {
        "php": ">=8.3",
        "embed/embed": "^4.0",
        "slim/psr7": "^1.3",
        "crudadmin/crudadmin": "^6.0|dev-6.0-dev"
    },
    "autoload": {
        "psr-4": {
            "Admin\\Gutenberg\\": "src"
        },
        "files": [
            "src/Contracts/Wordpress/boot.php",
            "src/Helpers/blocks.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Admin\\Gutenberg\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": "Admin\\Gutenberg\\Providers\\GutenbergServiceProvider"
        }
    }

}
